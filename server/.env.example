# ---------------------------------------------------------------------------
# MOVA backend
#
# Every value here is a SERVER secret. None of it is ever sent to the app —
# that is the entire reason the backend exists. Never copy any of these into
# the app's .env, where an EXPO_PUBLIC_ prefix would ship them to every device.
#
# MOVA runs with this file empty. DexScreener and the public Solana RPC need no
# credentials, so `npm start` serves real market data out of the box. Keys buy
# depth and reliability, not basic function.
# ---------------------------------------------------------------------------

PORT=8787

# --- On-chain ---------------------------------------------------------------
# Mint authority, freeze authority and holder concentration are read from chain
# state. The public endpoint below is the default and is heavily throttled;
# under load, safety checks intermittently report as unavailable.
#
# A Helius key replaces the RPC endpoint automatically — set it and nothing
# else changes.
# HELIUS_API_KEY=
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Optional enrichment ----------------------------------------------------
# Historical OHLCV. Without it, charts are built from prices this server has
# recorded since it started, so they begin short and lengthen as MOVA watches.
# BIRDEYE_API_KEY=

# Social signal. Without it, mention counts and bot-likeness report as
# unavailable rather than being estimated.
# X_BEARER_TOKEN=

# Written analysis. The deterministic writer is used when this is unset, which
# is the safer default: it can only describe data it was given.
# ANTHROPIC_API_KEY=

# --- Tuning -----------------------------------------------------------------
# How long an upstream response stays fresh in the shared cache.
UPSTREAM_CACHE_TTL_MS=15000
# Contract-level facts change rarely and are cached far longer.
STRUCTURAL_CACHE_TTL_MS=300000
# How often the tracked universe is rebuilt and a price sample recorded.
UNIVERSE_REFRESH_MS=60000
# Per-IP request ceiling. One client can otherwise burn shared vendor quota.
RATE_LIMIT_PER_MINUTE=120

# Comma-separated origin allowlist. Empty allows any origin, which is correct
# for a public read-only API consumed by a mobile app.
CORS_ORIGINS=

LOG_REQUESTS=true
