# ---------------------------------------------------------------------------
# MOVA — mobile app environment (values here are PUBLIC, they ship in the app)
# ---------------------------------------------------------------------------
# Data mode: "mock" (fully offline demo) | "live" (talk to the MOVA backend)
EXPO_PUBLIC_DATA_MODE=mock

# Base URL of the MOVA backend. Only used when EXPO_PUBLIC_DATA_MODE=live.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Optional: deterministic mock seed so demo data is identical across devices.
EXPO_PUBLIC_MOCK_SEED=mova-2025

# ---------------------------------------------------------------------------
# MOVA — backend environment (server/.env). NEVER put these in the app.
# ---------------------------------------------------------------------------
# PORT=8787
# BIRDEYE_API_KEY=
# HELIUS_API_KEY=
# ANTHROPIC_API_KEY=
# X_BEARER_TOKEN=
# UPSTREAM_CACHE_TTL_MS=15000
