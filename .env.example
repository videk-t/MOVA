# ---------------------------------------------------------------------------
# MOVA — mobile app environment
#
# EVERY VALUE HERE SHIPS INSIDE THE APP BUNDLE AND IS READABLE BY ANYONE WHO
# DOWNLOADS IT. That is what the EXPO_PUBLIC_ prefix means. Never put an API
# key in this file — upstream credentials belong in server/.env, which never
# leaves the machine running the backend.
# ---------------------------------------------------------------------------

# "mock" — fully offline demo data, no backend needed, every figure labelled.
# "live" — talk to the MOVA backend at EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_DATA_MODE=mock

# Base URL of the MOVA backend. Only read when DATA_MODE is "live".
#
# localhost works for the web build and an Android emulator via adb reverse.
# A physical phone needs this machine's LAN address instead, e.g.
# http://192.168.1.132:8787 — the phone cannot reach your localhost.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Deterministic seed so demo data is identical across devices and runs.
EXPO_PUBLIC_MOCK_SEED=mova-2025

# ---------------------------------------------------------------------------
# Backend configuration lives in server/.env — see server/.env.example.
# MOVA runs live with no credentials at all: DexScreener and the public Solana
# RPC need no key. Keys buy depth and reliability, not basic function.
# ---------------------------------------------------------------------------
